{
  "name": "cup-form",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/support/register-alias.mjs --test \"tests/*.test.ts\"",
    "test:integration": "node --import ./tests/support/register-alias.mjs --env-file-if-exists=.env --env-file-if-exists=.env.local --test \"tests/integration/*.test.ts\"",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "check:env": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.ts",
    "check:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-db.ts",
    "check:auth": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-auth.ts",
    "check:stripe": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-stripe.ts",
    "check:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke.ts",
    "preflight": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/preflight.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run prisma:validate && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/next": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "next": "16.4.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
